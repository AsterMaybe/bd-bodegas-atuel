# Configuración del proyecto - Copiar a .env y completar con valores reales
# NUNCA commitear el archivo .env real

# Servidor API
PORT=8000
ENV=production

# Base de datos PostgreSQL
DATABASE_URL=postgresql://app_rw:cambiar_por_un_secreto@db:5432/bodegas_atuel

# Pool de conexiones
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=5000

# Logging
LOG_LEVEL=info