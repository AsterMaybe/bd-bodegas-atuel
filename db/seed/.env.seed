# ============================================================
# Seed Configuration for Bodegas del Atuel
# Copy to .env.seed.local and modify as needed
# ============================================================

# Random seed for reproducibility
SEED=420

# ============================================================
# Volume Configuration (number of records to generate)
# ============================================================
N_EMP=60                    # Employees (personal base)
N_SALA=30                   # Sales rooms (salas de venta)
N_BODEGA=20                 # Wineries (bodegas)
N_TRANSP=15                 # Transporters (transportistas)
N_FINCA=40                  # Farms (fincas)
N_PARCELA_TARGET=600        # Total parcels across all fincas
N_VINO=400                  # Wines (vinos)
N_CLIENTE=20000             # Clients (clientes)
N_INGRESO=2500              # Income documents (ingresos)
N_TRANSF=2500               # Transfer documents (transferencias)
N_COMP=150000               # Sales receipts (comprobantes)

# ============================================================
# Campaign years for harvest lots
# ============================================================
CAMPAIGNS=2022,2023,2024,2025,2026

# ============================================================
# Client Type Distribution (must sum to N_CLIENTE)
# ============================================================
CLIENTE_SOCIO=12000         # Club members
CLIENTE_DISTRIBUIDOR=5000   # Distributors
CLIENTE_EXPORTADOR=3000     # Exporters

# ============================================================
# Employee Configuration
# ============================================================
EMP_SALARIO=650000.00       # Base employee salary
ENCARGADO_SALARIO=950000.00 # Regional manager salary
EMP_FECHA_INGRESO=2019-05-01
ENCARGADO_FECHA_INGRESO=2017-03-01

# ============================================================
# Farm Configuration
# ============================================================
FINCA_SUPERFICIE_MIN=5      # Min hectares per farm
FINCA_SUPERFICIE_MAX=200    # Max hectares per farm

# ============================================================
# Parcel Configuration
# ============================================================
PARCELA_SUPERFICIE_MIN=0.5  # Min hectares per parcel
PARCELA_SUPERFICIE_MAX=10   # Max hectares per parcel
PARCELA_ANO_MIN=1990        # Min planting year
PARCELA_ANO_MAX=2020        # Max planting year

# ============================================================
# Wine Configuration
# ============================================================
VINO_ANO_MIN=2019           # Min vintage year
VINO_ANO_MAX=2025           # Max vintage year
VINO_GRAD_MIN=10            # Min alcohol %
VINO_GRAD_MAX=14.5          # Max alcohol %
VINO_PRECIO_MIN=1000        # Min price
VINO_PRECIO_MAX=8000        # Max price
VINO_VOL_OPTIONS=187,375,750,1500,3000

# ============================================================
# Harvest Lot Configuration
# ============================================================
LOTE_KG_MIN=500             # Min kg per lot
LOTE_KG_MAX=8000            # Max kg per lot
LOTE_CAMPAIGNS_PER_PARCELA_MIN=2
LOTE_CAMPAIGNS_PER_PARCELA_MAX=4

# ============================================================
# Quality Analysis Ranges
# ============================================================
ANALISIS_BRIX_MIN=20
ANALISIS_BRIX_MAX=26
ANALISIS_PH_MIN=3.0
ANALISIS_PH_MAX=4.0
ANALISIS_ACIDEZ_MIN=4.0
ANALISIS_ACIDEZ_MAX=9.0

# ============================================================
# Income Document Configuration
# ============================================================
INGRESO_FECHA_MIN=2024
INGRESO_FECHA_MAX=2026
INGRESO_VINOS_PER_DOC_MIN=1
INGRESO_VINOS_PER_DOC_MAX=5
INGRESO_QTY_MIN=50
INGRESO_QTY_MAX=500

# ============================================================
# Transfer Document Configuration
# ============================================================
TRANSF_FECHA_MIN=2024
TRANSF_FECHA_MAX=2026
TRANSF_VINOS_PER_DOC_MIN=2
TRANSF_VINOS_PER_DOC_MAX=6
TRANSF_QTY_MIN=20
TRANSF_QTY_MAX=300

# ============================================================
# Sales Receipt Configuration
# ============================================================
COMPROBANTE_FECHA_MIN=2025
COMPROBANTE_FECHA_MAX=2026
COMPROBANTE_VINOS_PER_DOC_MIN=2
COMPROBANTE_VINOS_PER_DOC_MAX=6

# ============================================================
# Export Permit Configuration
# ============================================================
PERMISO_PAISES=Brasil,Chile,Uruguay,Paraguay,EEUU
PERMISO_PER_CLIENT_MIN=1
PERMISO_PER_CLIENT_MAX=2
PERMISO_DURATION_MIN=180
PERMISO_DURATION_MAX=1095

# ============================================================
# Database Connection (uses Docker env vars by default)
# ============================================================
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=bodegas_atuel
# PGUSER=postgres
# PGPASSWORD=password